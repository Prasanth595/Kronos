# ============================================================================
# deploy/config.env — EDIT THESE, then `source deploy/config.env` (or the
# scripts source it for you). Holds every knob for the GCP deployment.
# Nothing secret lives here (no API keys) so it is safe to commit; real keys
# go in the VM's own .env (see deploy/README.md).
# ============================================================================

# --- GCP project / location -------------------------------------------------
# asia-south1 = Mumbai (lowest latency for an India-based user).
PROJECT="${KRONOS_GCP_PROJECT:-CHANGE_ME}"
ZONE="${KRONOS_GCP_ZONE:-asia-south1-c}"
REGION="${KRONOS_GCP_REGION:-asia-south1}"

# --- VM shape ---------------------------------------------------------------
# e2-standard-4 = 4 vCPU / 16 GB. Kronos-small on CPU runs comfortably here.
# Spot/preemptible would be cheaper but can be yanked mid-forecast; for an
# on-demand demo box we use standard provisioning + aggressive auto-stop.
INSTANCE="${KRONOS_VM_NAME:-kronos-demo}"
MACHINE_TYPE="${KRONOS_MACHINE_TYPE:-e2-standard-4}"
BOOT_DISK_GB="${KRONOS_DISK_GB:-30}"
IMAGE_FAMILY="debian-12"
IMAGE_PROJECT="debian-cloud"

# --- App / port -------------------------------------------------------------
# The app binds 0.0.0.0:APP_PORT on the VM but is NOT exposed publicly; you
# reach it over an SSH tunnel (deploy/tunnel.sh) at localhost:LOCAL_PORT.
APP_PORT="${KRONOS_APP_PORT:-8000}"
LOCAL_PORT="${KRONOS_LOCAL_PORT:-8000}"
REMOTE_USER="${KRONOS_REMOTE_USER:-$USER}"
REMOTE_DIR="/opt/kronos_dashboard"

# --- Auto-stop watchdog (cost guard) ----------------------------------------
# Stop the VM after IDLE_MINUTES with no user request, or after HARD_CAP_HOURS
# of uptime no matter what. Guest-initiated shutdown moves the instance to
# TERMINATED, so VM billing stops (the boot disk still costs ~$1.20/mo).
IDLE_MINUTES="${KRONOS_IDLE_MIN:-30}"
HARD_CAP_HOURS="${KRONOS_HARD_CAP_HRS:-3}"

# --- Budget alert -----------------------------------------------------------
BUDGET_AMOUNT="${KRONOS_BUDGET:-30}"        # USD/month
BUDGET_NAME="kronos-demo-budget"

# --- Gemini (Vertex, keyless) -----------------------------------------------
# Layer-2 sentiment uses Vertex Gemini with the VM's service account (no key).
GEMINI_MODEL="${KRONOS_GEMINI_MODEL:-gemini-2.0-flash-001}"
VERTEX_LOCATION="${KRONOS_VERTEX_LOCATION:-asia-south1}"
